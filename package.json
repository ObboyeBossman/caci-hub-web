{
  "name": "caci-hub-web",
  "version": "1.0.0",
  "description": "CACI Hub — Church Assembly Management Platform",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local",
    "build": "tsc && vite build",
    "preview": "vite preview",

    "db:local:start": "supabase start",
    "db:local:stop": "supabase stop",
    "db:local:reset": "supabase db reset",
    "db:local:push": "supabase db push --local",
    "db:local:studio": "supabase studio",

    "db:dev:push": "supabase db push --project-ref YOUR-DEV-REF",
    "db:dev:diff": "supabase db diff --project-ref YOUR-DEV-REF",

    "db:prod:push": "supabase db push --project-ref cyjkjzcthbpkufbsyosz",

    "gen:types:dev": "supabase gen types typescript --project-id YOUR-DEV-REF > src/types/database.types.ts",
    "gen:types:prod": "supabase gen types typescript --project-id cyjkjzcthbpkufbsyosz > src/types/database.types.ts",
    "gen:types:local": "supabase gen types typescript --local > src/types/database.types.ts",

    "test": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "ag-grid-community": "^33.3.2",
    "alpinejs": "^3.14.9",
    "bootstrap": "^5.3.6",
    "bootstrap-icons": "^1.11.3",
    "cropperjs": "^1.6.2",
    "dayjs": "^1.11.13",
    "dompurify": "^3.2.6",
    "fuse.js": "^7.1.0",
    "html2canvas": "^1.4.1",
    "i18next": "^25.1.2",
    "jspdf": "^3.0.1",
    "notyf": "^3.10.0",
    "qrcode": "^1.5.4",
    "quill": "^2.0.3",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.27.0",
    "prettier": "^3.5.3",
    "supabase": "^2.102.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.2.1",
    "workbox-window": "^7.3.0"
  }
}
